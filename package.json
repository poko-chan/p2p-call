* { box-sizing: border-box; }

:root {
  --bg: #070b16;
  --panel: rgba(14, 20, 36, .92);
  --panel-2: rgba(20, 27, 46, .9);
  --border: rgba(255,255,255,.09);
  --text: #edf2ff;
  --muted: #9da8bf;
  --accent: #8aa5ff;
  --accent-2: #6e85ff;
  --danger: #ff667d;
  --ok: #5bd39a;
  --shadow: 0 24px 70px rgba(0,0,0,.35);
}

html, body { height: 100%; }
body {
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(1000px 700px at 18% -10%, rgba(78, 101, 205, .22), transparent 50%),
    radial-gradient(900px 700px at 100% 0%, rgba(37, 178, 151, .14), transparent 46%),
    var(--bg);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button, input, select { font: inherit; }
button { cursor: pointer; border: 0; color: inherit; }
.hidden { display: none !important; }

.app-shell {
  min-height: 100%;
  display: grid;
  grid-template-rows: 72px 1fr;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22px;
  border-bottom: 1px solid var(--border);
  background: rgba(7, 11, 22, .76);
  backdrop-filter: blur(18px);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand { display: flex; align-items: center; gap: 10px; min-width: 180px; }
.brand-mark {
  width: 34px; height: 34px; border-radius: 11px;
  display: grid; place-items: center;
  background: linear-gradient(135deg, #8298ff, #5968da);
  box-shadow: 0 8px 22px rgba(100,120,255,.35);
  font-weight: 900;
}
.brand-name { font-weight: 800; letter-spacing: .3px; }
.brand-sub { color: var(--muted); font-size: 11px; margin-top: 1px; }

.room-center { position: absolute; left: 50%; transform: translateX(-50%); }
.room-badge, .soft-btn, .icon-btn, .control-btn {
  border: 1px solid var(--border);
  background: rgba(255,255,255,.05);
  transition: .2s ease;
}
.room-badge {
  display: flex; align-items: center; gap: 9px;
  padding: 9px 12px; border-radius: 12px;
  color: var(--muted);
}
.room-badge:hover, .soft-btn:hover, .icon-btn:hover, .control-btn:hover { background: rgba(255,255,255,.1); }
.status-dot { width: 8px; height: 8px; border-radius: 50%; background: #65708a; }
.copy-glyph { opacity: .65; }

.top-actions, .stage-actions, .control-cluster { display: flex; align-items: center; gap: 8px; }
.soft-btn { border-radius: 10px; padding: 9px 12px; color: #dfe6fb; }
.icon-btn { width: 38px; height: 38px; border-radius: 10px; }
.primary-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white; border-radius: 11px; padding: 10px 15px;
  box-shadow: 0 10px 26px rgba(99, 121, 255, .22);
  font-weight: 700;
}
.primary-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
.primary-btn.big { padding: 13px 22px; font-size: 15px; }
.primary-btn.full { width: 100%; }

.workspace {
  min-height: 0;
  display: grid;
  grid-template-columns: 1fr 360px;
}

.stage {
  min-width: 0;
  position: relative;
  overflow: hidden;
  background: rgba(5, 9, 18, .38);
}

.empty-state {
  height: 100%;
  min-height: 600px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: 40px;
}
.hero-orb {
  width: 82px; height: 82px; border-radius: 28px; display: grid; place-items: center;
  font-size: 35px;
  background: linear-gradient(150deg, rgba(139,165,255,.22), rgba(72,204,172,.12));
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: var(--shadow);
}
.empty-state h1 { font-size: clamp(28px, 4vw, 46px); margin: 24px 0 9px; letter-spacing: -1.3px; }
.empty-state p { color: var(--muted); max-width: 670px; line-height: 1.7; margin: 0; }
.feature-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 25px 0; }
.feature-row span {
  padding: 8px 11px; border: 1px solid var(--border); border-radius: 999px;
  background: rgba(255,255,255,.035); color: #ccd4e9; font-size: 13px;
}
.small-note, .modal-foot { color: #79849d; font-size: 12px; margin-top: 13px; }

.call-stage { height: 100%; display: flex; flex-direction: column; padding: 16px; }
.stage-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.stage-title { display: flex; gap: 10px; align-items: baseline; font-weight: 700; }
.muted { color: var(--muted); font-weight: 500; font-size: 12px; }

.video-grid {
  flex: 1; min-height: 0; display: grid; gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: minmax(180px, 1fr);
}
.video-grid[data-layout="speaker"] { grid-template-columns: 1fr; grid-template-rows: 1fr; }
.video-grid[data-layout="focus"] { grid-template-columns: 1fr; grid-auto-rows: 1fr; }

.video-tile {
  position: relative; overflow: hidden; border-radius: 18px;
  background: #111827; border: 1px solid var(--border); min-height: 160px;
  box-shadow: 0 12px 30px rgba(0,0,0,.18);
}
.video-tile video { width: 100%; height: 100%; object-fit: cover; display: block; }
.video-tile.local video { transform: scaleX(-1); }
.video-meta {
  position: absolute; left: 11px; right: 11px; bottom: 11px;
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.name-chip {
  background: rgba(4,7,13,.7); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.1);
  border-radius: 999px; padding: 7px 10px; font-size: 12px;
}
.tile-badges { display: flex; gap: 6px; }
.tile-badge { background: rgba(4,7,13,.7); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; padding: 6px 8px; font-size: 11px; }

.side-panel { min-height: 0; background: var(--panel); border-left: 1px solid var(--border); display: flex; flex-direction: column; }
.panel-tabs { display: grid; grid-template-columns: repeat(3,1fr); padding: 10px; border-bottom: 1px solid var(--border); gap: 5px; }
.tab { padding: 10px 6px; border-radius: 9px; background: transparent; color: var(--muted); }
.tab.active { background: rgba(255,255,255,.07); color: var(--text); }
.tab-panel { flex: 1; min-height: 0; display: none; flex-direction: column; }
.tab-panel.active { display: flex; }

.chat-messages { flex: 1; overflow: auto; padding: 14px; }
.chat-item { display: flex; gap: 9px; margin-bottom: 14px; }
.avatar {
  flex: 0 0 30px; width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center;
  background: rgba(138,165,255,.16); color: #cbd4ff; font-weight: 700; font-size: 11px;
}
.chat-body { min-width: 0; }
.chat-top { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
.chat-name { font-weight: 700; font-size: 12px; }
.chat-time { color: #67728a; font-size: 10px; }
.chat-text { color: #dbe2f4; line-height: 1.5; overflow-wrap: anywhere; font-size: 13px; }
.system-message { color: #7f8ba4; background: rgba(255,255,255,.03); border: 1px dashed var(--border); padding: 11px; border-radius: 12px; font-size: 12px; line-height: 1.55; }
.chat-compose { display: flex; gap: 8px; border-top: 1px solid var(--border); padding: 11px; }
.chat-compose input, .field input, .field select {
  width: 100%; border: 1px solid var(--border); background: rgba(255,255,255,.04); color: var(--text);
  border-radius: 10px; padding: 10px 11px; outline: none;
}
.chat-compose input:focus, .field input:focus, .field select:focus { border-color: rgba(138,165,255,.6); }
.send-btn { width: 42px; border-radius: 10px; background: rgba(138,165,255,.18); }

.file-head { padding: 18px 14px 12px; border-bottom: 1px solid var(--border); }
.file-head h3 { margin: 0 0 4px; font-size: 15px; }
.file-head p { margin: 0 0 12px; color: var(--muted); line-height: 1.5; font-size: 12px; }
.file-transfers { overflow: auto; padding: 12px; }
.transfer {
  padding: 11px; border: 1px solid var(--border); background: rgba(255,255,255,.025);
  border-radius: 12px; margin-bottom: 9px;
}
.transfer-row { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; }
.progress { height: 5px; background: rgba(255,255,255,.07); border-radius: 999px; overflow: hidden; margin-top: 9px; }
.progress > div { height: 100%; width: 0; background: linear-gradient(90deg, #86a0ff, #62d7b2); transition: width .15s; }

.people-head { display:flex; align-items:center; justify-content:space-between; padding: 16px 14px; border-bottom: 1px solid var(--border); }
.people-head h3 { margin:0; font-size:15px; }
.count-pill { min-width: 26px; padding:5px 8px; text-align:center; border-radius: 999px; background: rgba(255,255,255,.08); color: #b8c1d7; font-size: 11px; }
.people-list { padding: 10px; overflow:auto; }
.person { display:flex; align-items:center; gap:10px; padding: 10px; border-radius: 11px; }
.person:hover { background: rgba(255,255,255,.035); }
.person-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); margin-left:auto; }

.control-bar {
  position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%);
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  background: rgba(9,14,27,.86); backdrop-filter: blur(18px);
  border: 1px solid var(--border); border-radius: 18px; padding: 9px;
  box-shadow: 0 22px 60px rgba(0,0,0,.38); z-index: 30;
}
.control-btn { min-width: 44px; height: 44px; border-radius: 13px; font-size: 17px; }
.control-btn.wide { padding: 0 14px; font-size: 12px; }
.hangup-btn { padding: 12px 20px; border-radius: 13px; background: rgba(255,102,125,.18); border: 1px solid rgba(255,102,125,.24); color: #ffb4bf; font-weight: 800; }
.control-btn.active { background: rgba(138,165,255,.18); border-color: rgba(138,165,255,.35); }

.modal-backdrop { position: fixed; inset: 0; display:grid; place-items:center; background:rgba(3,6,13,.72); backdrop-filter: blur(10px); z-index: 50; padding: 18px; }
.modal { width: min(620px, 100%); background: #0f1628; border: 1px solid var(--border); border-radius: 22px; padding: 22px; box-shadow: var(--shadow); }
.modal-head { display:flex; justify-content:space-between; gap: 15px; align-items:flex-start; margin-bottom:18px; }
.eyebrow { font-size:10px; letter-spacing: .17em; color:#7f8aaa; font-weight:800; margin-bottom:5px; }
.modal h2 { margin:0; font-size:24px; letter-spacing:-.5px; }
.field { display:block; margin-bottom: 13px; }
.field > span { display:block; color:#aeb7cc; font-size:12px; margin-bottom:7px; }
.room-input-row { display:flex; gap:8px; }
.room-input-row .soft-btn { white-space: nowrap; }
.device-preview { display:grid; grid-template-columns: 170px 1fr; gap: 13px; margin: 16px 0; }
.preview-card { position:relative; aspect-ratio: 16 / 10; background:#090d17; border-radius:14px; overflow:hidden; border:1px solid var(--border); }
.preview-card video { width:100%; height:100%; object-fit:cover; }
.preview-label { position:absolute; left:8px; bottom:8px; padding:5px 7px; border-radius:7px; background:rgba(0,0,0,.6); font-size:10px; }
.preview-copy { align-self:center; }
.preview-copy strong { display:block; margin-bottom:5px; }
.preview-copy span { color:var(--muted); font-size:12px; line-height:1.55; }
.settings-actions { display:flex; justify-content:flex-end; margin-top:15px; }

.toast-stack { position:absolute; right:18px; bottom:86px; display:flex; flex-direction:column; gap:7px; z-index:10; }
.toast { padding:10px 12px; border-radius:10px; background:rgba(12,18,31,.9); border:1px solid var(--border); color:#dbe3f7; font-size:12px; box-shadow: var(--shadow); animation: slideIn .18s ease; }
@keyframes slideIn { from { opacity:0; transform:translateY(5px) } to { opacity:1; transform:none } }

.reaction-float { pointer-events:none; position:absolute; inset:0; overflow:hidden; }
.reaction-pop { position:absolute; left:50%; bottom: 14%; font-size: 35px; animation: floatUp 1.7s ease-out forwards; }
@keyframes floatUp {
  0% { opacity:0; transform: translate(-50%, 20px) scale(.8) }
  15% { opacity:1 }
  100% { opacity:0; transform: translate(-50%, -260px) scale(1.25) }
}

@media (max-width: 980px) {
  .workspace { grid-template-columns: 1fr; grid-template-rows: 1fr 300px; }
  .side-panel { border-left: 0; border-top: 1px solid var(--border); }
}
@media (max-width: 700px) {
  .topbar { padding: 0 12px; }
  .room-center { display:none; }
  .workspace { grid-template-rows: minmax(460px, 1fr) 330px; }
  .video-grid { grid-template-columns: 1fr; grid-auto-rows: minmax(170px, 1fr); }
  .control-bar { bottom: 10px; gap: 6px; }
  .control-btn { min-width: 40px; height: 40px; }
  .control-btn.wide { padding: 0 10px; }
  .hangup-btn { padding: 11px 13px; }
  .device-preview { grid-template-columns: 1fr; }
}
